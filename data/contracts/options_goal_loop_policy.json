  "proof_gates": {
    "full_denominator_required": true,
    "healthier_pf_lower_bound_after_stress_gte": 1.2,
    "largest_single_winner_pct_of_net_profit_lt": 25.0,
    "leave_one_trade_out_pf_lower_bound_gt": 1.0,
    "minimum_exact_completed_forward_rows": 30,
    "minimum_pf_lower_bound_after_stress_gt": 1.0,
    "preferred_exact_completed_forward_rows": 50,
    "single_ticker_date_month_dependency_allowed": false,
    "top_three_winners_pct_of_net_profit_lt": 50.0
  },
  "state_transitions": {
    "blocked_forward_gate": "continue_or_reject_based_on_blocker",
    "eligible_for_frozen_paper_validation_review": "produce_review_packet",
    "failed_forward_gate": "reject_current_lane",
    "no_candidate": "stop_research_search",
    "promotion_policy_violation": "stop_immediately",
    "protocol_missing": "prepare_forward_denominator_protocol",
    "safety_violation": "stop_immediately",
    "strong_paper_shadow_packet": "produce_review_packet",
    "underpowered_forward_evidence": "continue_paper_shadow_only"
  },
  "stopped_branches": [
    "combined_portfolio as promotion path",
    "bullish_pullback_core as promotion path",
    "lane_a_chain_native_ret20_4_stop200_time75 as promotion path",
    "tracked_winner_cheap_debit_continuity_v1 current shape",
